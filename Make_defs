MURaM_HOME_DIR = /glade/work/rempel/MURaM_NCAR/MURaM_main/
FFTW3_HOME = $(MURaM_HOME_DIR)/FFTW_LIBS/fftw_26.1
HEFFTE_HOME = $(MURaM_HOME_DIR)/FFTW_LIBS/heffte_cpu_26.1
CUDA_HOME =

# FFT = FFTW or HEFFTE or HEFFTE_CPU
FFT =HEFFTE_CPU

# output name
PROGRAM = mhd3d.x

# Optimization option
OPT = -O2 -std=c++11 -Mnofma #-ta=tesla:cc70 -Minfo=accel
#OPT = -O2 -acc=multicore -Minfo=accel -std=c++11 #-Mnofma
#OPT = -O3 -acc -gpu=cc80,nofma,lineinfo -Minfo=accel -Mnofma -std=c++11

# Debugging option (for development) use -pg -g3
#DBG = -g

# FILEPATH option (default: ./) - This is useful
# to write files to special directories on some machines
FILEPATH = ./

# Machine architecture
ARCH = rs6000
########################################################

######## Custom Flags for MURaM ########################
CUSTOM_FLAGS = -DMURAM_$(FFT)

######## The shell command #############################
SHELL=/bin/sh

######## FFT Options ###################################
ifdef FFTW3_HOME

FFTWHOME   = $(FFTW3_HOME)
FFTWLIBDIR = -L$(FFTWHOME)/lib
FFTWINCDIR = -I$(FFTWHOME)/include

ifeq ($(FFT), FFTW)
FFTWLIB = -lfftw3_mpi -lfftw3_threads -lfftw3
endif
ifeq ($(FFT), HEFFTE_CPU)
FFTWLIB = -lfftw3 -lfftw3f
endif
ifeq ($(FFT), HEFFTE)
FFTWLIB = -lfftw3 -lfftw3f
endif

else
FFTWHOME =
FFTWLIB =
FFTWLIBDIR =
FFTWINCDIR =
endif
######## CUDA Options ##################################
ifdef CUDA_HOME
CUDAHOME = $(CUDA_HOME)
CUDALIB = -lcufft -lcudart
CUDALIBDIR = -L$(CUDAHOME)/lib64
CUDAINCDIR = -I$(CUDAHOME)/include
else
CUDAHOME =
CUDALIB =
CUDALIBDIR =
CUDAINCDIR =
endif
######## HEFFTE Options ################################
ifdef HEFFTE_HOME

HEFFTEHOME   = $(HEFFTE_HOME)
HEFFTELIBDIR = -L$(HEFFTEHOME)/lib
HEFFTEINCDIR = -I$(HEFFTEHOME)/include
HEFFTELIB    = -lheffte

else
HEFFTEHOME =
HEFFTELIB =
HEFFTELIBDIR =
HEFFTEINCDIR =
endif
########################################################
MASSLIB = 

######### MPI options ##################################
MPIHOME=
MPILIBDIR=
MPIINCDIR=
MPILIB=

######### ROMIO options #################################
MPIOLIBDIR=
MPIOINCDIR=
MPIOLIB=

######### General options ##############################
          
DEFS = $(OPT) $(CUSTOM_FLAGS) $(DBG) $(PRE)

######### Automatic header dependencies ################
# -MMD emits a <object>.d file listing the project headers each object was
#      compiled against, which the Makefiles -include so that editing a header
#      rebuilds every object that uses it. Without this, changing e.g. rt.h
#      leaves stale objects compiled against the old class layout, and the
#      resulting binary silently reads members at the wrong offsets.
# -MP  emits a phony target for each header so that renaming or deleting one
#      does not abort the build with "No rule to make target".
# Set to empty if building with a compiler that lacks these options.
DEPFLAGS = -MMD -MP

INCLUDES = -I../ -I$(MURaM_HOME_DIR)/include -I$(MURaM_HOME_DIR)/src/rt $(MPIINCDIR) $(MPIOINCDIR) \
     $(HEFFTEINCDIR) $(FFTWINCDIR) $(CUDAINCDIR)

LIBS = $(MPILIBDIR) $(MPIOLIB) $(MPILIB) \
       $(HEFFTELIBDIR) $(HEFFTELIB) \
       $(FFTWLIBDIR) $(FFTWLIB) \
       $(CUDALIBDIR) $(CUDALIB) \
       $(MASSLIB) -lm

######### C options #####################################
CC     = mpicc
LD     = mpicxx -acc
CCC    = mpicxx

CFLAGS  = $(DEFS) $(INCLUDES)  $(DEPFLAGS) 
CCFLAGS = $(CFLAGS)

LDFLAGS      = $(DEFS) 
LDFLAGS      += $(LIBS)

######## Mixed  command #################################
RM          = rm
AR          = ar
RANLIB    = ranlib

######### Suffix rules ########################################
.SUFFIXES :    .o .cc .c .C .cpp .c++

.c.o:
	$(CC) $(CFLAGS) -c $<
.C.o:
	$(CCC) $(CCFLAGS) -c $<
.cpp.o:
	$(CCC) $(CCFLAGS) -c $<
.c++.o:
	$(CCC) $(CCFLAGS) -c $<
.cc.o:
	$(CCC) $(CCFLAGS) -c $<

